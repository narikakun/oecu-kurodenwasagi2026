# OpenAIのプロジェクトAPIキー。実際の値はGitへ保存しないでください。
OPENAI_API_KEY=sk-your-api-key

# GPT-Live
LIVE_MODEL=gpt-live-1
# 詳しい質問を処理するResponsesバックエンド。通常の雑談では呼ばれません。
LIVE_BACKEND_MODEL=gpt-6-luna
LIVE_VOICE=marin
# 自由会話へ追加したい指示がある場合だけ設定します。
LIVE_INSTRUCTIONS=

# 起動時に会話画面をChromiumのキオスクモードで自動表示します。
DISPLAY_KIOSK=true
# 通常は空欄で自動検出します。必要な場合だけ実行ファイル名か絶対パスを指定します。
DISPLAY_KIOSK_BROWSER=

# Raspberry Pi GPIO（BCM番号）
HOOK_GPIO=17
DIAL_GPIO=26

# 実機で論理が逆だった場合は true / false を変更します。
HOOK_LIFTED_WHEN_LOW=false

# USB受話器。空欄ならsounddeviceの既定デバイスを使います。
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# USB音声デバイスが24kHz非対応なら、対応する値（例: 48000）にします。
AUDIO_DEVICE_SAMPLE_RATE=24000

# ベル用の別スピーカー。python -m sounddeviceで表示される番号か名前を指定します。
BELL_OUTPUT_DEVICE=
BELL_DEVICE_SAMPLE_RATE=48000
BELL_VOLUME=0.7

# 開発PCでGPIOなしに起動確認するときだけtrueにします。
MOCK_GPIO=false
