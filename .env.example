# OpenAIのプロジェクトAPIキー。実際の値はGitへ保存しないでください。
OPENAI_API_KEY=sk-your-api-key

# GPT-Live
LIVE_MODEL=gpt-live-1
# 通信サービス担当と警察担当は別セッション・別音声です。
LIVE_VOICE=marin
LIVE_POLICE_VOICE=cedar
# シナリオ本体はコードにあります。ここには必要な追加指示だけを書きます。
LIVE_INSTRUCTIONS=

# Raspberry Pi GPIO（BCM番号）
HOOK_GPIO=17
DIAL_GPIO=27

# 実機で論理が逆だった場合は true / false を変更します。
HOOK_LIFTED_WHEN_LOW=false
DIAL_PULSE_WHEN_LOW=true

# USB受話器。空欄ならsounddeviceの既定デバイスを使います。
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# USB音声デバイスが24kHz非対応なら、対応する値（例: 48000）にします。
AUDIO_DEVICE_SAMPLE_RATE=24000

# 文字起こしの断片を1行にまとめる待ち時間（ミリ秒）
TRANSCRIPT_FLUSH_MS=800

# 最初の「もしもし」に返事がない場合、再度呼びかけるまでの時間
INITIAL_SILENCE_PROMPT_MS=5000

# 参加者が話し終えてからAIが返答しない場合、再応答を促すまでの時間
TURN_REPLY_TIMEOUT_MS=4500

# 担当切替中の保留音量（0.0～1.0）
HOLD_MUSIC_VOLUME=0.15

# 開発PCでGPIOなしに起動確認するときだけtrueにします。
MOCK_GPIO=false
